# ===========================================
# .NET Clean Architecture Boilerplate
# Environment Configuration Example
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# JWT Settings
JWT_ISSUER_SIGNING_KEY=your-super-secret-key-at-least-32-chars
JWT_VALID_ISSUER=Boilerplate
JWT_VALID_AUDIENCE=Boilerplate
JWT_EXPIRATION=00:15:00
JWT_REFRESH_TOKEN_EXPIRATION=7.00:00:00

# MongoDB Settings
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=basirah

# CORS (comma-separated origins, or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
